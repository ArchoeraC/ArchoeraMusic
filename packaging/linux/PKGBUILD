# Arch Linux 打包定义（配合 packaging/linux/package.sh arch 在 CI 中构建）
# 产物：archoera-music-<pkgver>-1-x86_64.pkg.tar.zst
# 说明：bundle.tar.zst / archoera-music.desktop / awa.archoera.betastudio2.archoera_music.png
#       由 package.sh arch 预置在同目录（md5sums=SKIP）。

pkgname=archoera-music
pkgver=0.8.4
pkgrel=1
pkgdesc="An open-source music player, connect to alternative music service, support offline playback"
arch=('x86_64')
url="https://github.com/ArchoeraC/ArchoeraMusic"
license=('AGPL-3.0-only')
# bundle 为 Release 预 strip 产物（Rust/Go/NativeAOT/C 均无调试符号），
# 禁用 makepkg 的 strip/debug 处理：strip 无事可做，而 gdb-add-index 对
# 无调试符号的 ELF 每次报 "No debugging symbols / No index was created"
options=('!strip' '!debug')
depends=(
  'glibc'
  'gcc-libs'
  'gtk3'
  # 平台桥接（native/libarchoera_platform.so）：托盘走 StatusNotifierItem +
  # dbusmenu（libdbus-1.so.3），窗口状态经 dlopen GTK/GDK（gtk3 + libx11 + libxi）。
  # 均为既有依赖，无额外系统包。
  'dbus'
  'libepoxy'
  'fontconfig'
  'fribidi'
  'libx11'
  'libxi'
  'at-spi2-atk'
  'libcloudproviders'
  # 引擎/ scraper 的运行库已随 bundle 内嵌并带 RUNPATH=$ORIGIN：引擎用自建
  # 最小 FFmpeg（不依赖系统 ffmpeg），scraper 的 TagLib 也一并内嵌；taglib
  # 保留作兜底（其自身依赖 zlib/gcc-libs 已在列表中）。
  'taglib'
  'curl'
  'openssl'
  'sqlite'
  'xz'
  'zlib'
)
source=('bundle.tar.zst' 'archoera-music.desktop' 'awa.archoera.betastudio2.archoera_music.png')
md5sums=('SKIP' 'SKIP' 'SKIP')

package() {
  # 整个 bundle 装到 /opt/archoera-music（FFI/引擎子进程均相对可执行文件定位）
  install -d "$pkgdir/opt/archoera-music"
  cp -a "$srcdir/bundle/." "$pkgdir/opt/archoera-music/"
  install -d "$pkgdir/usr/bin"
  ln -s /opt/archoera-music/archoera_music "$pkgdir/usr/bin/archoera_music"
  # 桌面条目 + 图标（文件名 = 应用 ID，保证 Wayland 任务栏图标映射）
  install -Dm644 "$srcdir/archoera-music.desktop" \
    "$pkgdir/usr/share/applications/awa.archoera.betastudio2.archoera_music.desktop"
  install -Dm644 "$srcdir/awa.archoera.betastudio2.archoera_music.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/awa.archoera.betastudio2.archoera_music.png"
}
