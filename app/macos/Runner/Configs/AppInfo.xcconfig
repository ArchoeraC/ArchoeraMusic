// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = archoera_music

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.archoera.archoeraMusic

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 io.awa.archoera.betastudio2. All rights reserved.

// Swift ⇄ C：暴露原生 archoerashell 入口（app/core/shell 的 Rust staticlib）。
SWIFT_OBJC_BRIDGING_HEADER = Runner/Runner-Bridging-Header.h

// 链入 archoerashell staticlib：cargo 由 Runner.xcodeproj 的
// “Build archoerashell (cargo)” 构建阶段生成（按 ARCHS 逐架构 lipo 成 fat 库，
// 见 app/core/shell/target/universal/release）。
// -liconv 为 Rust std 在 macOS 上的系统依赖（`cargo rustc --print native-static-libs`）。
LIBRARY_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../core/shell/target/universal/release"
OTHER_LDFLAGS = $(inherited) -larchoera_shell -liconv
