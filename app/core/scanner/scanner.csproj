<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>archoera-scanner</AssemblyName>
    <RootNamespace>Archoera.Scanner</RootNamespace>
    <!-- 框架依赖发布（runtime 由运行时镜像提供，跨架构友好） -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Log.cs 经函数指针 / NativeMemory 走统一日志 sink，需 unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 启用 .NET 自带分析器（与 IDE 一致，构建期即暴露警告） -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- 子项目 scanner-ffi 是独立 AOT 库，不得编入 CLI -->
    <Compile Remove="scanner-ffi/**" />
    <!-- 侧车歌词读取：与 indexer **共用同一源文件**。扫描器在遍历目录时解析 .lrc 并写入
         library.db（lyrics_lrc* + lrc_mtime/size/checked），索引器 / 播放侧只读 DB。 -->
    <!-- 文本脚本分类（汉字 / 假名 / 谚文 / 拉丁）：与其它模块共用同一源文件 -->
    <Compile Include="../shared/text/ScriptRanges.cs" Link="shared/text/ScriptRanges.cs" />
    <Compile Include="../shared/lyrics/LrcReader.cs" Link="shared/lyrics/LrcReader.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- TagLibSharp: 音频元数据解析（MP3/FLAC/OGG/M4A/APE/WAV/DSF 等） -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <!-- Microsoft.Data.Sqlite: 直写 SQLite，绕过 Node.js V8 堆 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- CVE-2025-6965 (GHSA-2m69-gcr7-jv3q, High): SQLitePCLRaw.lib.e_sqlite3
         <= 2.1.11 捆绑的 SQLite < 3.50.2 存在聚合项内存损坏。
         Microsoft.Data.Sqlite 10 起 managed 核心为 SQLitePCLRaw 3.0.x，原生库版本
         号跟随 SQLite 版本；显式 pin 到最新的纯原生静态库包 3.53.3（无 managed
         依赖），消除该 CVE 并避免回落到捆绑的旧原生 SQLite。 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 自研内核元数据快路径动态库（audio-engine zig-out 产物；存在则随 CLI 输出分发）。
         KernelMetadata 以结构化 C ABI（无 JSON）直桥，缺失时回退 TagLibSharp。 -->
    <None Include="../audio-engine/zig-out/lib/libarchoera_kernel.so"
          Link="libarchoera_kernel.so" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../audio-engine/zig-out/lib/libarchoera_kernel.so')" />
    <None Include="../audio-engine/zig-out/lib/libarchoera_kernel.dylib"
          Link="libarchoera_kernel.dylib" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../audio-engine/zig-out/lib/libarchoera_kernel.dylib')" />
    <None Include="../audio-engine/zig-out/bin/archoera_kernel.dll"
          Link="archoera_kernel.dll" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../audio-engine/zig-out/bin/archoera_kernel.dll')" />
  </ItemGroup>

</Project>
