<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>scanner-ffi</AssemblyName>
    <RootNamespace>Archoera.Scanner.Ffi</RootNamespace>
    <!-- NativeAOT 共享库：dotnet publish -r &lt;rid&gt; 产出 libscanner-ffi.so/.dylib/.dll，
         供 Flutter FFI 直接调用，彻底脱离 sidecar 子进程 -->
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- TagLibSharp 经 TrimmerRootAssembly 完整保留，不会实际 trim；
         IL2104（Assembly produced trim warnings）属分析期汇总提示，抑制之 -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <!-- 启用 .NET 自带分析器 + AOT/trim 分析（与 IDE 一致，构建期即暴露警告） -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- 共享 scanner 源码（与 CLI 同源；显式 Link 而非通配 "../*.cs"：
         通配链接项目目录外的文件时，部分 IDE/设计时构建不会把其纳入编译与
         System.Text.Json 源生成，导致 ScannerJsonContext 未生成（缺 Default /
         未实现抽象成员）的假错。逐文件显式列出并 Link 可稳定解决。 -->
    <!-- 文本脚本分类（汉字 / 假名 / 谚文 / 拉丁）：与其它模块共用同一源文件 -->
    <Compile Include="../../shared/text/ScriptRanges.cs" Link="shared/text/ScriptRanges.cs" />
    <Compile Include="../Models.cs" Link="Models.cs" />
    <Compile Include="../Log.cs" Link="Log.cs" />
    <Compile Include="../IScannerDatabase.cs" Link="IScannerDatabase.cs" />
    <Compile Include="../ScannerEngine.cs" Link="ScannerEngine.cs" />
    <Compile Include="../KernelMetadata.cs" Link="KernelMetadata.cs" />
    <Compile Include="../KernelLoudness.cs" Link="KernelLoudness.cs" />
    <Compile Include="../SqliteDirectWriter.cs" Link="SqliteDirectWriter.cs" />
    <Compile Include="../AdaptiveBatchSize.cs" Link="AdaptiveBatchSize.cs" />
    <Compile Include="../AdaptiveConcurrency.cs" Link="AdaptiveConcurrency.cs" />
    <Compile Include="../SystemMemoryInfo.cs" Link="SystemMemoryInfo.cs" />
    <!-- 侧车歌词读取：与 indexer / scanner CLI **共用同一源文件**（§4.4：扫描器解析 .lrc 入库） -->
    <Compile Include="../../shared/lyrics/LrcReader.cs" Link="shared/lyrics/LrcReader.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- TagLibSharp: 音频元数据解析（MP3/FLAC/OGG/M4A/APE/WAV/DSF 等） -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <!-- Microsoft.Data.Sqlite: 直写 SQLite（与 CLI 一致） -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- CVE-2025-6965 (GHSA-2m69-gcr7-jv3q, High): 同 scanner.csproj，
         pin 原生 SQLite 到 3.53.3 消除 NU1903；managed 核心随
         Microsoft.Data.Sqlite 10 升级到 SQLitePCLRaw 3.0.x -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- NativeAOT 默认启用 trimming，TagLib.File.Create 依赖反射注册具体文件类型；
         保留整个程序集防止运行期 "No file type found" -->
    <TrimmerRootAssembly Include="TagLibSharp" />
  </ItemGroup>

  <!-- NativeAOT 库内嵌 .NET 运行时：SQLitePCLRaw 经 DllImport("e_sqlite3")
       在运行期按文件名 dlopen 原生 SQLite。.NET 10 AOT 起为纯文件名搜索，
       RTLD_GLOBAL 绝对路径预加载不再命中（库无 SONAME，glibc 不识别为已加载）。
       给产物加 RUNPATH（Linux $ORIGIN / macOS @loader_path），使任何进程
       （flutter 测试、真机 bundle）加载 scanner-ffi 时均能在同目录解析
       libe_sqlite3。Windows 默认按模块目录解析，无需处理。 -->
  <ItemGroup>
    <LinkerArg Include="-Wl,-z,origin"
               Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
    <LinkerArg Include="-Wl,-rpath,'$ORIGIN'"
               Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
    <LinkerArg Include="-Wl,-rpath,@loader_path"
               Condition="$(RuntimeIdentifier.StartsWith('osx'))" />
  </ItemGroup>

  <!-- 产物约定：复制到 scanner/build/（与 audio-engine/build 同级约定）。
       三平台命名差异：
         - Linux   : libscanner-ffi.so + libe_sqlite3.so
         - macOS   : libscanner-ffi.dylib + libe_sqlite3.dylib
         - Windows : scanner-ffi.dll + e_sqlite3.dll（NativeAOT 无 lib 前缀；
                     publish 目录含 x64 子目录，故用 $(PublishDir) 不硬编码路径） -->
  <Target Name="CopyToScannerBuild" AfterTargets="Publish">
    <ItemGroup>
      <!-- 每个平台只存在自己的文件名；Exists 过滤防止跨平台 Copy 报 MSB3030 -->
      <ScannerArtifacts Include="$(PublishDir)$(AssemblyName).so" Condition="Exists('$(PublishDir)$(AssemblyName).so')" />
      <ScannerArtifacts Include="$(PublishDir)$(AssemblyName).dll" Condition="Exists('$(PublishDir)$(AssemblyName).dll')" />
      <ScannerArtifacts Include="$(PublishDir)$(AssemblyName).dylib" Condition="Exists('$(PublishDir)$(AssemblyName).dylib')" />
      <ScannerArtifacts Include="$(PublishDir)libe_sqlite3.so" Condition="Exists('$(PublishDir)libe_sqlite3.so')" />
      <ScannerArtifacts Include="$(PublishDir)libe_sqlite3.dylib" Condition="Exists('$(PublishDir)libe_sqlite3.dylib')" />
      <ScannerArtifacts Include="$(PublishDir)e_sqlite3.dll" Condition="Exists('$(PublishDir)e_sqlite3.dll')" />
      <!-- 自研内核元数据快路径动态库（随 FFI 同目录分发，$ORIGIN 解析） -->
      <ScannerArtifacts Include="$(MSBuildProjectDirectory)/../../audio-engine/zig-out/lib/libarchoera_kernel.so" Condition="Exists('$(MSBuildProjectDirectory)/../../audio-engine/zig-out/lib/libarchoera_kernel.so')" />
      <ScannerArtifacts Include="$(MSBuildProjectDirectory)/../../audio-engine/zig-out/lib/libarchoera_kernel.dylib" Condition="Exists('$(MSBuildProjectDirectory)/../../audio-engine/zig-out/lib/libarchoera_kernel.dylib')" />
      <ScannerArtifacts Include="$(MSBuildProjectDirectory)/../../audio-engine/zig-out/bin/archoera_kernel.dll" Condition="Exists('$(MSBuildProjectDirectory)/../../audio-engine/zig-out/bin/archoera_kernel.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(ScannerArtifacts)"
          DestinationFolder="$(MSBuildProjectDirectory)/../build/"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
