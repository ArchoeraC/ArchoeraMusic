<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>indexer-ffi</AssemblyName>
    <RootNamespace>Archoera.Indexer.Ffi</RootNamespace>
    <!-- NativeAOT 共享库：dotnet publish -r &lt;rid&gt; 产出 libindexer-ffi.so/.dylib/.dll，
         供 Flutter FFI 直接调用（进程内、无子进程） -->
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- IL2104（Assembly produced trim warnings）属分析期汇总提示，抑制之 -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- 共享 indexer 源码（与 CLI / 测试同源；显式 Link 而非通配 "../*.cs"，
         避免把 CLI 的 Program.cs 编入共享库导致入口冲突） -->
    <Compile Include="../Analyzer.cs" Link="Analyzer.cs" />
    <Compile Include="../Pinyin.cs" Link="Pinyin.cs" />
    <Compile Include="../PinyinSegmenter.cs" Link="PinyinSegmenter.cs" />
    <Compile Include="../HanziData.cs" Link="HanziData.cs" />
    <Compile Include="../Log.cs" Link="Log.cs" />
    <Compile Include="../IndexStore.cs" Link="IndexStore.cs" />
    <Compile Include="../FtsStore.cs" Link="FtsStore.cs" />
    <Compile Include="../IndexerEngine.cs" Link="IndexerEngine.cs" />
    <Compile Include="../IndexerJson.cs" Link="IndexerJson.cs" />
    <Compile Include="../LrcReader.cs" Link="LrcReader.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 分析器数据表，LogicalName 固定供 HanziData 按名查找（NativeAOT 安全）。
         nfkc：兼容折叠；def_*：Unihan 释义查询扩展（T1 查询侧跨语言候选）。
         拼音/繁简/全角走 ToolGood.Words，GB18030 走框架 CodePages。 -->
    <EmbeddedResource Include="../data/nfkc.tsv" Link="data/nfkc.tsv">
      <LogicalName>Archoera.Indexer.data.nfkc.tsv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../data/def_en2hanzi.tsv" Link="data/def_en2hanzi.tsv">
      <LogicalName>Archoera.Indexer.data.def_en2hanzi.tsv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../data/def_hanzi2en.tsv" Link="data/def_hanzi2en.tsv">
      <LogicalName>Archoera.Indexer.data.def_hanzi2en.tsv</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- 与 scanner 同栈同版本：Microsoft.Data.Sqlite（MIT）+ 原生 SQLite（Apache-2.0），
         含 FTS5。CVE-2025-6965 修复见 scanner.csproj 说明，pin 3.53.3 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- 拼音（含词级多音字消歧）/ 繁简 / 全角半角：ToolGood.Words（Apache-2.0）。
         NativeAOT 需 TrimmerRootAssembly 保根。 -->
    <PackageReference Include="ToolGood.Words" Version="3.1.0.3" />
    <TrimmerRootAssembly Include="ToolGood.Words" />
  </ItemGroup>

  <!-- NativeAOT 库内嵌 .NET 运行时：SQLitePCLRaw 经 DllImport("e_sqlite3")
       在运行期按文件名 dlopen 原生 SQLite。给产物加 RUNPATH（Linux $ORIGIN /
       macOS @loader_path），使任何进程加载 indexer-ffi 时均能在同目录解析
       libe_sqlite3。Windows 默认按模块目录解析，无需处理。 -->
  <ItemGroup>
    <LinkerArg Include="-Wl,-z,origin"
               Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
    <LinkerArg Include="-Wl,-rpath,'$ORIGIN'"
               Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
    <LinkerArg Include="-Wl,-rpath,@loader_path"
               Condition="$(RuntimeIdentifier.StartsWith('osx'))" />
  </ItemGroup>

  <!-- 产物约定：复制到 indexer/build/（与 scanner/build 同级约定）。
       Linux: libindexer-ffi.so + libe_sqlite3.so；macOS: .dylib；Windows: indexer-ffi.dll + e_sqlite3.dll -->
  <Target Name="CopyToIndexerBuild" AfterTargets="Publish">
    <ItemGroup>
      <IndexerArtifacts Include="$(PublishDir)$(AssemblyName).so" Condition="Exists('$(PublishDir)$(AssemblyName).so')" />
      <IndexerArtifacts Include="$(PublishDir)$(AssemblyName).dylib" Condition="Exists('$(PublishDir)$(AssemblyName).dylib')" />
      <IndexerArtifacts Include="$(PublishDir)$(AssemblyName).dll" Condition="Exists('$(PublishDir)$(AssemblyName).dll')" />
      <IndexerArtifacts Include="$(PublishDir)libe_sqlite3.so" Condition="Exists('$(PublishDir)libe_sqlite3.so')" />
      <IndexerArtifacts Include="$(PublishDir)libe_sqlite3.dylib" Condition="Exists('$(PublishDir)libe_sqlite3.dylib')" />
      <IndexerArtifacts Include="$(PublishDir)e_sqlite3.dll" Condition="Exists('$(PublishDir)e_sqlite3.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(IndexerArtifacts)"
          DestinationFolder="$(MSBuildProjectDirectory)/../build/"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
