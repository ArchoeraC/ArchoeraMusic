//
// archoerashell.exe 的版本资源（与 Flutter 传入的版本宏对齐）。
// 无签名的 PE 至少应有完整 VERSIONINFO：缺元数据的裸 exe 更容易被 AV 的
// 启发式/信誉模型当成投放器。

#pragma code_page(65001)
#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP_ICON            ICON                    "resources\\app_icon.ico"

#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define VERSION_AS_NUMBER 1,0,0,0
#endif

#if defined(FLUTTER_VERSION)
#define VERSION_AS_STRING FLUTTER_VERSION
#else
#define VERSION_AS_STRING "1.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "io.awa.archoera.betastudio2"
            VALUE "FileDescription", "ArchoeraMusic command-line client"
            VALUE "FileVersion", VERSION_AS_STRING
            VALUE "InternalName", "archoerashell"
            VALUE "LegalCopyright", "Copyright (C) 2026 io.awa.archoera.betastudio2"
            VALUE "OriginalFilename", "archoerashell.exe"
            VALUE "ProductName", "ArchoeraMusic"
            VALUE "ProductVersion", VERSION_AS_STRING
            VALUE "Comments", "https://github.com/ArchoeraC/ArchoeraMusic"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
