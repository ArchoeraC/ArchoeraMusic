# ArchoeraMusic — 仓库级忽略

# 根目录大文件（二进制归档/APK）
*.tar.gz
*.apk

# Flutter / Dart
app/build/
app/.dart_tool/
app/.flutter-plugins*
app/android/.gradle/
app/ios/Pods/
app/.idea/
app/.metadata

# scanner（NativeAOT FFI / CLI 构建产物；build/ 由 app/core/scanner/build.sh 产出）
app/core/scanner/bin/
app/core/scanner/obj/
app/core/scanner/build/
app/core/scanner/scanner-ffi/bin/
app/core/scanner/scanner-ffi/obj/

# vcpkg manifest 模式默认安装目录（workflow 已用 VCPKG_INSTALLED_DIR 指到 C:\vcpkg\installed，此处兜底）
app/vcpkg_installed/

# scraper（C++ 刮削器 FFI / CLI 构建产物；build/ 由 app/core/scraper CMake 产出）
app/core/scraper/build/

# C 音频引擎（app/core/audio-engine/build/ 由 cmake 产出）
app/core/audio-engine/build/
# EraAudio 基准/变体构建目录（build-min / build-max / build-ac3 等，cmake 产出）
app/core/audio-engine/build-*/
app/core/audio-engine/tempo-target/
app/core/audio-engine/tempo-rs/target/

# 平台能力桥接（app/native/platform/build/ 由 cmake 产出）
app/native/platform/build/

# 统一日志核心（app/native/log/build/ 由 cmake 产出；MSVC 中间产物 *.obj）
app/native/log/build/
app/native/log/*.obj

# C 音频引擎（本地测试产物：kernel/*.zig 编译出的可执行文件 + 解码输出的媒体数据）
app/core/audio-engine/*_dump
app/core/audio-engine/*_probe
app/core/audio-engine/check
app/core/audio-engine/mdct_dbg_test
app/core/audio-engine/*.pcm

# subsonic（Go c-shared + Rust 转码器 cdylib；build/ 由 build.sh 产出）
app/core/subsonic/build/
app/core/subsonic/transcoder/target/

# downloader（Rust 下载器 cdylib）
app/core/downloader/target/

# shell（Rust 内嵌原生 CLI staticlib，链入 runner）
app/core/shell/target/

# vault（C# NativeAOT 凭据保险库；build*/ 由 build.sh / build-test.sh 产出）
app/core/vault/build/
app/core/vault/src/build/
app/core/vault/src/bin/
app/core/vault/src/obj/

# vault-rs（Rust 静态凭据保险库；cargo target/ + build.sh / build-test.sh 产物）
app/core/vault-rs/target/
app/core/vault-rs/build/

# 打包输出（packaging/linux/package*.sh 的中间暂存与最终产物）
dist/
packaging/linux/work/

# IDE / 编辑器
.idea/
.vscode/
*.iml

# 系统
.DS_Store
*.log

*.key
# 防伪签名私钥（绝不入库；公钥 watermark_pub*.pem 需跟踪）
*_priv.pem
*_priv.key
# 内嵌参考仓库（本地保留，不入库/不 submodule；供代码移植参考）
reference/

# 图标素材/候选源（本地提取与对照用；入库的只有 app/eta-tools/eta_icons 定稿集与最终字体）
Icon化/

# 本地问题截图（仅调试用，不入库）
issuescreenshot/

# Nix build result symlink
/result
/result-*

# 本地临时测试（封面取色对照预览等，作者标注不入库）
app/test/*_manual_test.dart

# 编辑器临时文件（Kate swap / vim swap / 备份）
*.kate-swp
*.swp
*.swo
*~
*.bak
